FROM eclipse-temurin:25-jre-alpine-3.23

RUN mkdir -p /home/gtnh
WORKDIR /home/gtnh

# move in server files
COPY packaging/server/ ./
COPY .minecraft/journeymap ./journeymap
COPY .minecraft/serverutilities ./serverutilities
# separate quests from rest of config, since that gets updated A LOT more than anything else there
COPY --exclude=.minecraft/config/betterquesting/DefaultQuests/ .minecraft/config ./config
COPY .minecraft/config/betterquesting/DefaultQuests ./config/betterquesting/

# use default argument file (not unsup modified)
RUN rm java9args.txt && mv java9args_default.txt java9args.txt

# === GENERATED BY PACKSCRIPTS IMAGE - DO NOT EDIT ===
# Generated: 2026-05-14T02:53:11.383Z  window: 50 commits
# Buckets: 2  Promoted: gtnhlib, dreamcraft, gregtech

COPY ./staging/mods/other/ mods/
COPY ./staging/mods/github/ mods/
COPY ./staging/mods/gtnhlib/ mods/
COPY ./staging/mods/dreamcraft/ mods/
COPY ./staging/mods/gregtech/ mods/
# === END PACKSCRIPTS IMAGE ===

ENTRYPOINT [ "tail", "-f", "/dev/null" ]