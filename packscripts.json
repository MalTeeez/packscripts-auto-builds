{
    "RELATIVE_INSTANCE_DIRECTORY": "./",
    "MOD_BASE_DIR": "./.minecraft/mods",
    "ANNOTATED_FILE": "./annotated_mods.json",
    "PACKAGING": {
        "PACK_NAME": "GTNH Daily",
        "PACKAGE_DIRECTORY": "./packaging/",
        "GIT_REMOTE_URL": "https://raw.githubusercontent.com/malteeez/packscripts-auto-builds/gtnh-daily",
        "GIT_LFS_REMOTE_URL": "https://github.com/malteeez/packscripts-auto-builds/raw/gtnh-daily",
        "PACK_VARIANTS": {
            "client": {
                "TYPE": "client",
                "REQUIRED_MOD_TAGS": [
                    "SIDE.CLIENT"
                ],
                "EXCLUDED_MOD_TAGS": [],
                "TRACK_INCLUDE_PATHS": [
                    {
                        "path": "./.minecraft"
                    }
                ],
                "FORCE_INCLUDE_PATHS": [
                    {
                        "path": "./packaging/unsup.jar",
                        "include_as": ".minecraft/unsup.jar.new"
                    },
                    {
                        "path": "./packaging/unsup-launcher.jar",
                        "include_as": ".minecraft/unsup-launcher.jar",
                        "dont_track": true
                    },
                    {
                        "path": "./packaging/client/unsup.ini",
                        "include_as": ".minecraft/unsup.ini"
                    },
                    {
                        "path": "./packaging/client/instance.cfg",
                        "include_as": "instance.cfg",
                        "dont_track": true
                    },
                    {
                        "path": "./libraries",
                        "include_as": "libraries"
                    },
                    {
                        "path": "./patches",
                        "include_as": "patches"
                    },
                    {
                        "path": "./mmc-pack.json",
                        "include_as": "mmc-pack.json"
                    },
                    {
                        "path": "./gtnh_icon.png",
                        "include_as": "gtnh_icon.png"
                    }
                ],
                "EXCLUDE_FROM_INCLUDE_PATHS": [
                    "./.minecraft/mods/disabled_mods"
                ],
                "EXCLUDE_PATTERNS": [
                    "\\.git\\w+$"
                ]
            },
            "server": {
                "TYPE": "server",
                "REQUIRED_MOD_TAGS": [
                    "SIDE.SERVER"
                ],
                "EXCLUDED_MOD_TAGS": [],
                "TRACK_INCLUDE_PATHS": [
                    {
                        "path": "./.minecraft/mods",
                        "include_as": "mods"
                    },
                    {
                        "path": "./.minecraft/config",
                        "include_as": "config"
                    },
                    {
                        "path": "./.minecraft/scripts",
                        "include_as": "scripts"
                    },
                    {
                        "path": "./.minecraft/journeymap",
                        "include_as": "journeymap"
                    },
                    {
                        "path": "./.minecraft/serverutilities",
                        "include_as": "serverutilities"
                    }
                ],
                "FORCE_INCLUDE_PATHS": [
                    {
                        "path": "./packaging/unsup.jar",
                        "include_as": "unsup.jar.new"
                    },
                    {
                        "path": "./packaging/unsup-launcher.jar",
                        "include_as": "unsup-launcher.jar",
                        "dont_track": true
                    },
                    {
                        "path": "./packaging/server/",
                        "include_as": ""
                    }
                ],
                "EXCLUDE_FROM_INCLUDE_PATHS": [
                    "./.minecraft/mods/disabled_mods",
                    "./packaging/server/unsup/",
                    "./.minecraft/config/txloader"
                ],
                "EXCLUDE_PATTERNS": [
                    "\\.git\\w+$",
                    "\\.minecraft\\/config\\/amazingtrophies\\/lang\\/(?!en_US)\\w{2}_\\w{2}\\.lang$",
                    "\\.minecraft\\/config\\/Betterloadingscreen\\/tips\\/(?!en_US)\\w{2}_\\w{2}\\.txt$",
                    "\\.minecraft\\/config\\/GTNewHorizons\\/CustomToolTips_\\w{2}_\\w{2}\\.xml$",
                    "\\.minecraft\\/config\\/InGameInfoXML\\/InGameInfo_\\w{2}_\\w{2}\\.xml$",
                    "\\.minecraft\\/mods\\/OpenSecurity\\/sounds\\/alarms\\/.+\\.ogg"
                ]
            }
        },
        "MAX_WORKER_THREADS": 10
    }
}